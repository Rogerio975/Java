<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="350.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.PrimaryController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <TextField fx:id="display" editable="false" alignment="CENTER_RIGHT" prefHeight="70.0" prefWidth="330.0" text="0">
         <font>
            <Font size="36.0" />
         </font>
      </TextField>
      <GridPane hgap="5.0" vgap="5.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Button onAction="#handleClear" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="C" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Button disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Button disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <Button onAction="#handleOperator" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="/" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <!-- Row 1: 7, 8, 9, * -->
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="7" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="8" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="9" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Button onAction="#handleOperator" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="*" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <!-- Row 2: 4, 5, 6, - -->
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="4" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="5" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="6" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <Button onAction="#handleOperator" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="-" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <!-- Row 3: 1, 2, 3, + -->
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="1" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="2" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="3" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Button onAction="#handleOperator" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="+" GridPane.columnIndex="3" GridPane.rowIndex="3" />

            <!-- Row 4: 0, ., = -->
            <Button onAction="#handleNumber" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4" />
            <Button onAction="#handleDecimal" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="." GridPane.columnIndex="2" GridPane.rowIndex="4" />
            <Button onAction="#handleEquals" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="=" GridPane.columnIndex="3" GridPane.rowIndex="4" />
         </children>
      </GridPane>
   </children>
</VBox>